# Learnexia — cross-platform line-ending & binary normalization
# Goal: every text file is stored as LF in the repo, regardless of OS.
# Windows checkouts can still keep CRLF in the working tree via core.autocrlf,
# but the committed blobs stay LF so diffs are clean across machines.
#
# One-time apply after adding/changing this file (run on your machine):
#   git add --renormalize .
#   git commit -m "chore: normalize line endings via .gitattributes"
# Expect a large one-time diff — that is normal.

# ---- Default: auto-detect text, normalize to LF in the repo ----
* text=auto eol=lf

# =============================================================
# Text files — force LF (tools/CI/scripts must not get CRLF)
# =============================================================

# Source & config (.NET / TS / JS / web)
*.cs        text eol=lf
*.csproj    text eol=lf
*.sln       text eol=lf -crlf
*.props     text eol=lf
*.targets   text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.mdx       text eol=lf
*.txt       text eol=lf
*.csv       text eol=lf
*.svg       text eol=lf
*.env       text eol=lf

# Shell scripts MUST be LF (CRLF breaks them on Linux/macOS/CI)
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf
*.fish      text eol=lf

# Dotfiles / no-extension config commonly used in this repo
.gitattributes text eol=lf
.gitignore     text eol=lf
.editorconfig  text eol=lf
.npmrc         text eol=lf
.nvmrc         text eol=lf
Dockerfile     text eol=lf
*.dockerfile   text eol=lf

# =============================================================
# Text files that MUST stay CRLF (Windows-only tooling)
# =============================================================
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# =============================================================
# Binary files — never normalize, never diff as text
# (`binary` is shorthand for `-text -diff`)
# =============================================================

# Images
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.webp      binary
*.bmp       binary
*.tif       binary
*.tiff      binary
*.avif      binary

# Fonts
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary

# Documents
*.pdf       binary

# Archives
*.zip       binary
*.gz        binary
*.tgz       binary
*.bz2       binary
*.7z        binary
*.rar       binary
*.tar       binary

# Media
*.mp3       binary
*.mp4       binary
*.mov       binary
*.webm      binary
*.wav       binary

# Compiled / misc binaries
*.dll       binary
*.exe       binary
*.pdb       binary
*.pfx       binary
*.snk       binary
*.keystore  binary
