<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      Eval tests: excluded from default CI run.
      All tests in the offline tier are tagged [Trait("Category", "EvalOffline")] and run without live keys.
      To run the offline tier: dotnet test (path) -filter Category=EvalOffline
      The live tier [Trait("Category", "EvalLive")] requires real provider keys - devops/launch Gate B only,
      not in CI.
    -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Ai\Learnexia.Modules.Ai.Application\Learnexia.Modules.Ai.Application.csproj" />
    <ProjectReference Include="..\..\src\Modules\Ai\Learnexia.Modules.Ai.Infrastructure\Learnexia.Modules.Ai.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Shared\Learnexia.Shared.Contracts\Learnexia.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Shared\Learnexia.Shared.Resources\Learnexia.Shared.Resources.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Data\safety-eval-set.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\safety-eval-results.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
