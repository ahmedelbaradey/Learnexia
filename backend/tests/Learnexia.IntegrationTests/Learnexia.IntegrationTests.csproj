<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Testing frameworks -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
    <!-- In-process API hosting -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Testcontainers PostgreSQL (3.x API: PostgreSqlBuilder) -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- Testcontainers generic container (ContainerBuilder) — used to spin up MinIO for avatar tests -->
    <PackageReference Include="Testcontainers" />
    <!-- Testcontainers Redis — used by P4-10 Redis realtime gamification state tests -->
    <PackageReference Include="Testcontainers.Redis" />
  </ItemGroup>

  <!-- Reference the Host project — it pulls in all modules transitively -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Host\Learnexia.Host\Learnexia.Host.csproj" />
  </ItemGroup>
</Project>
