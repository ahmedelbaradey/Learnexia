  "AiHelper": {
    // Context provider selection. Allowed values:
    //   (absent / any other value) → EmptyLearningContextProvider (always redirects — safe default).
    //   "Rag"                      → RagContextProvider (live pgvector retrieval).
    // Set to "Rag" ONLY after:
    //   1. Curriculum:Embedding:BaseUrl + ModelVersion are configured.
    //   2. POST /api/Admin/Curriculum/ReEmbed has been triggered and completed (placeholder row count = 0).
    //   3. Curriculum:Retrieval:SimilarityDistanceFloor has been re-calibrated for real BGE-M3 geometry.
    "ContextProvider": "",
    // ── AiResponseCache settings (WI-B1 / IGlobalSettingsProvider bootstrap defaults) ──────────
    // These values are read via IGlobalSettingsProvider.GetDecimal/GetInt("ai.cache.*", fallback).
    // They map to this section via BootstrapDefaultGlobalSettingsProvider (dot → AiHelper:Cache: prefix).
    // P10-12 upgrade makes them admin-editable in the DB without a deployment.
    "Cache": {
      // ── AI Cache Activation (AI Cache Activation feature) ──────────────────────────────────────
      // Master kill-switch for runtime auto-approval. Set to false to freeze all cache entries at
      // PendingReview (dormant / pre-activation behaviour). Default: true (activation live).
      // Change to false at runtime if you need to pause serving cached responses without a deploy.
      "autoApproveEnabled": true,
      // Safety-pass confidence: the decimal confidence assigned to SafeAiResult when ALL safety
      // checks pass (Toxicity + AgeAppropriateness + Hallucination). Because the three safety
      // checks are boolean classifiers (no numeric score at this phase), this setting is the
      // sentinel value for "this response genuinely passed ALL safety gates". It must be >= the
      // autoApprovalConfidence threshold (0.85) for auto-approval to fire.
      // Default: 0.90 — comfortably above the 0.85 approval threshold.
      "safetyPassConfidence": 0.90,
      // Minimum model confidence for a runtime-generated response to be auto-approved (ReviewStatus=Approved).
      // Below this threshold → PendingReview (human review required before the entry becomes a cache hit).
      // Raise toward 0.90 if reviewers find many mistakes; lower toward 0.80 if quality is excellent.
      // NEVER read this from AiGatewayOptions or a hardcoded constant — always via IGlobalSettingsProvider.
      "autoApprovalConfidence": 0.85,
      // Maximum distinct normalized wrong-answer variants stored per QuestionId in AiResponseCache (Type=WhyWrong).
      // LRU eviction (by CreatedAt) when the cap is exceeded. Prevents unbounded cache growth.
      "whyWrongVariantCap": 50,
      // Number of similar-example variation indices (0..N-1) pre-generated per skill for the Practice pool.
      // At runtime a random index in [0, practicePoolSize-1] is selected to rotate examples.
      // Bump to >= 10 when the question bank grows (via admin settings update — no code change needed after P10-12).
      "practicePoolSize": 5
    }
  },
  "Curriculum": {
    "Embedding": {
      // Base URL of the self-hosted BGE-M3 TEI endpoint (e.g. "http://hetzner-host:8080").
      // Leave empty until BE-0 TEI is provisioned. Empty → BgeM3EmbeddingProvider returns null (RAG dormant).
      "BaseUrl": "",
      // Bearer token for TEI endpoint auth. NEVER commit a non-empty value.
      // Set via environment variable: Curriculum__Embedding__AuthToken=<secret>
      "AuthToken": "",
      // Embedding model slug served by the TEI endpoint (e.g. "bge-m3").
      "Model": "bge-m3",
      // Pinned TEI model version. Must match the value actually served by the endpoint.
      // REQUIRED when BaseUrl is set — absent ModelVersion blocks embedding (parity guard WI-A1).
      // Example: "1.0"
      "ModelVersion": ""
    },
    "Retrieval": {
      // Cosine distance threshold. Chunks whose distance exceeds this floor are rejected.
      // IMPORTANT — RE-CALIBRATION REQUIRED (WI-A3):
      //   The current value 0.4 was tuned to placeholder hash-vector geometry (seed-placeholder-v0).
      //   Real BGE-M3 embeddings have a different distance distribution. After re-embed completes,
      //   run evaluation queries against the real corpus and adjust this value to balance:
      //     - Too strict (low value) → over-redirects (students get "no context" even for in-corpus queries).
      //     - Too loose (high value) → irrelevant chunks in context (retrieval quality degrades).
      //   Typical BGE-M3 cosine distances for semantically similar text are 0.1 – 0.35.
      //   Recommend starting at 0.3 and adjusting based on observed retrieval quality.
      "SimilarityDistanceFloor": 0.4
    }
  },
  "Ai": {
    // ── AI provider API keys ─────────────────────────────────────────────────────────────────────
    // NEVER commit non-empty values for these keys. Set via environment variables or secret store:
    //   Claude: Ai__Providers__Claude__ApiKey=<anthropic-key>
    //   OpenAI: Ai__Providers__OpenAi__ApiKey=<openai-key>
    // Absent key → gateway returns AiError.Unavailable (fail-closed via SafetyLayer). No crash.
    // Both are optional at startup; a clear startup log is emitted if either is absent.
    "Providers": {
      "Claude": {
        "ApiKey": ""
      },
      "OpenAi": {
        "ApiKey": ""
      }
    },
    "Safety": {
      "EnableToxicityCheck": true,
      "EnableAgeCheck": true,
      "EnableHallucinationCheck": true,
      "MaxRegenerationAttempts": 2,
      "ModerationProvider": "Claude",
      "FallbackMessageKey": "AiContentBlocked",
      "GatewayErrorFallbackKey": "AiServiceUnavailable"
    }
  },
  "QuizSelection": {
    "Engine": {
      "HardRatio": 0.7,
      "MediumRatio": 0.6,
      "EasyRatio": 0.7,
      "BlendRatio": 0.3
    }
  },
  "Adaptivity": {
    "Engine": {
      "WeightAccuracy": 0.5,
      "WeightTime": 0.2,
      "WeightHint": 0.2,
      "WeightRetry": 0.1,
      "HighBand": 0.8,
      "LowBand": 0.5,
      "ExpectedAttempts": 2,
      "FatigueSignalWeight": 0.0
    }
  },
  "StudentProfile": {
    "Engine": {
      "MinSamplePerQuestionType": 5,
      "RecurringErrorThreshold": 3,
      "AccuracyDropThreshold": 0.15,
      "AttentionWindowMinutes": 20,
      "ColdStartDataPointThreshold": 10
    }
  },
  "Recommendations": {
    // P5-09a — Profile-aware recommendation selection (Moderate rule set).
    // Thresholds here are product-tunables; change without redeploy.
    "Engine": {
      // Minutes at or below which a child is considered fatigue-prone (rule b/c).
      // Mirrors StudentProfile:Engine:AttentionWindowMinutes default (20).
      "AttentionSpanFatigueThresholdMinutes": 20,
      // Maximum items when child is fatigue-prone (rule b). Must be ≤ MaxItems.
      "FatigueQuantityCap": 3,
      // Minimum items always returned on the non-cold-start path.
      "MinItems": 3,
      // Maximum items in a normal (non-fatigue) set. Spec cap = 5.
      "MaxItems": 5,
      // DataPointCount threshold for low-confidence → apply rule (a) only.
      // Mirrors StudentProfile:Engine:ColdStartDataPointThreshold (10).
      "ConfidenceDataPointThreshold": 10,
      // When true: bounded difficulty nudge (Hard→Medium, Medium→Easy) on Review items
      // for fatigue-prone children only. Never crosses the adaptivity band.
      "DifficultyNudgeEnabled": true
    }
  },
  "SpacedRepetition": {
    "Engine": {
      "IntervalLadderDays": [ 1, 3, 7, 14, 30 ],
      "NeedsReviewIntervalDays": 1,
      "JobCronExpression": "0 0 * * *"
    }
  },
  "Calibration": {
    // P5-07 — Calibration Engine (per-question empirical difficulty + AI quality flags).
    // All thresholds are product-tunables — change without redeploy.
    "Engine": {
      // Minimum StudentAnswer rows required before any proposal/flag is considered (small-sample guard).
      "MinSamples": 30,
      // P-value (fraction correct, 0.0–1.0) at/above which a question is empirically Easy.
      "EasyThreshold": 0.85,
      // P-value at/below which a question is empirically Hard. Medium band is between these two.
      "HardThreshold": 0.45,
      // AI-flag: p-value at/above which an AI question is flagged (nearly everyone correct → suspiciously easy).
      "AiFlagHighPValue": 0.95,
      // AI-flag: p-value at/below which an AI question is flagged (very few correct → suspiciously hard/broken).
      "AiFlagLowPValue": 0.20,
      // Cron schedule for the calibration job. Default: 00:20 UTC daily (after SP-Recompute and Rec-Recompute).
      "JobCronExpression": "20 0 * * *"
    }
  },
  "Billing": {
    // ── P10-04 — Daily soft-cap hard-stop feature flag ────────────────────────────
    // When false (default): daily cap is SOFT — the UI shows a warning but spend continues.
    // When true: daily cap is HARD — spending above the daily cap is blocked (graceful decline).
    // This is a deployment feature flag; it is NOT a managed GlobalSetting key
    // (changing it requires a config/env-var update, not an admin UI write).
    "HardStopEnabled": false,
    // ── P10-02 — Monthly grant job schedule (cron + timezone are deployment concerns) ─
    // Amounts come from GlobalSettings (credits.free_monthly / credits.premium_monthly).
    "GrantJob": {
      "CronExpression": "0 1 1 * *",
      "TimeZoneId": "UTC"
    },
    // ── BILLING-HARDEN-01 — xmin OCC retry policy ─────────────────────────────────
    // Tunable parameters for CreditLedgerService + CreditSpendService optimistic-
    // concurrency retry loop. Raise MaxRetries to tolerate higher concurrent-debit
    // contention. The back-off fires AFTER the failed transaction is disposed/rolled
    // back — never while a lock is held.
    //   MaxRetries  : total retries after first failure (attempts = MaxRetries + 1)
    //   BaseDelayMs : base for exponential back-off (delay = min(MaxDelayMs, BaseDelayMs * 2^i))
    //   MaxDelayMs  : cap on the deterministic part of the delay
    //   JitterMs    : max random jitter added to each delay
    "Concurrency": {
      "MaxRetries": 6,
      "BaseDelayMs": 20,
      "MaxDelayMs": 250,
      "JitterMs": 50
    }
  },
  "Gamification": {
    "Streak": {
