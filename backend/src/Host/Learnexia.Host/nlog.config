<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog configuration (P6-05 Observability).
  Created from scratch — no prior nlog.config existed (CONVENTIONS §13).

  Targets:
    - coloredConsole : coloured output to stdout.
    - rollingFile    : rolling daily file under logs/learnexia-{shortdate}.log.

  Trace/span correlation:
    - ${activity:property=TraceId} and ${activity:property=SpanId} embed the active
      System.Diagnostics.Activity trace/span ids so every log line joins the OTel trace.
      This depends on BE-1 (OTel ASP.NET Core instrumentation) populating Activity.Current
      on request-scoped log lines.
    - ${aspnet-traceidentifier} is the ASP.NET request TraceIdentifier (same value as
      HttpContext.TraceIdentifier) — a fallback correlation id when no OTel Activity is active.

  Security rules:
    - Do NOT add layout renderers that emit request body, response body, or Authorization headers.
    - Do NOT add ${var:connectionString} or any renderer that could emit secrets.
    - The layout below captures only: timestamp, level, traceId, spanId, logger, message, exception.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

  <targets>
    <!-- Coloured console — development/container stdout -->
    <target xsi:type="ColoredConsole"
            name="coloredConsole"
            layout="${longdate} | ${level:uppercase=true:padding=-5} | traceId=${activity:property=TraceId:whenEmpty=${aspnet-traceidentifier}} spanId=${activity:property=SpanId} | ${logger:shortName=true} | ${message}${onexception:inner= | EXCEPTION\: ${exception:format=ToString}}" />

    <!-- Rolling daily file — keeps last 30 files (~1 month at default verbosity) -->
    <target xsi:type="File"
            name="rollingFile"
            fileName="${basedir}/logs/learnexia-${shortdate}.log"
            archiveFileName="${basedir}/logs/archive/learnexia-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveDays="30"
            concurrentWrites="true"
            keepFileOpen="false"
            encoding="utf-8"
            layout="${longdate} | ${level:uppercase=true:padding=-5} | traceId=${activity:property=TraceId:whenEmpty=${aspnet-traceidentifier}} spanId=${activity:property=SpanId} | ${logger} | ${message}${onexception:inner= | EXCEPTION\: ${exception:format=ToString}}" />
  </targets>

  <rules>
    <!-- Suppress noisy framework namespaces at Information; keep Microsoft.Hosting.Lifetime visible -->
    <logger name="Microsoft.EntityFrameworkCore.*"   minlevel="Warn"        writeTo="coloredConsole,rollingFile" final="true" />
    <logger name="Microsoft.AspNetCore.*"            minlevel="Warn"        writeTo="coloredConsole,rollingFile" final="true" />
    <logger name="System.Net.Http.*"                 minlevel="Warn"        writeTo="coloredConsole,rollingFile" final="true" />
    <logger name="Hangfire.*"                        minlevel="Warn"        writeTo="coloredConsole,rollingFile" final="true" />

    <!-- Application code at Debug+ to both targets -->
    <logger name="Learnexia.*"                       minlevel="Debug"       writeTo="coloredConsole,rollingFile" />

    <!-- Everything else at Info+ -->
    <logger name="*"                                 minlevel="Information"  writeTo="coloredConsole,rollingFile" />
  </rules>
</nlog>
