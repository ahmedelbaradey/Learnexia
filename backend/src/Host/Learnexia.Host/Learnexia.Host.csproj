<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Learnexia.Host</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" />
    <PackageReference Include="AspNetCoreRateLimit" />
    <!-- BE-4 (P6-06): Redis-backed rate-limit store (activates when ConnectionStrings:Redis is set) -->
    <PackageReference Include="AspNetCoreRateLimit.Redis" />
    <PackageReference Include="Asp.Versioning.Mvc" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <!-- Health checks (P1-07) -->
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <!-- Background-jobs host (P1-07) -->
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <!-- Observability — OpenTelemetry tracing + metrics (P6-05). Versions centrally managed in Directory.Packages.props. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>
  <ItemGroup>
    <!-- P6-05: nlog.config must be in the output directory so NLog auto-discovers it at startup. -->
    <Content Update="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Learnexia.Shared.Kernel\Learnexia.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\Shared\Learnexia.Shared.Contracts\Learnexia.Shared.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\Learnexia.Modules.Identity.Api\Learnexia.Modules.Identity.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Learning\Learnexia.Modules.Learning.Api\Learnexia.Modules.Learning.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Parent\Learnexia.Modules.Parent.Api\Learnexia.Modules.Parent.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Notifications\Learnexia.Modules.Notifications.Api\Learnexia.Modules.Notifications.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Gamification\Learnexia.Modules.Gamification.Api\Learnexia.Modules.Gamification.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Moderation\Learnexia.Modules.Moderation.Api\Learnexia.Modules.Moderation.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Ai\Learnexia.Modules.Ai.Api\Learnexia.Modules.Ai.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Curriculum\Learnexia.Modules.Curriculum.Api\Learnexia.Modules.Curriculum.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Billing\Learnexia.Modules.Billing.Api\Learnexia.Modules.Billing.Api.csproj" />
    <ProjectReference Include="..\..\Modules\Analytics\Learnexia.Modules.Analytics.Api\Learnexia.Modules.Analytics.Api.csproj" />
  </ItemGroup>
</Project>
