{
  "name": "@learnexia/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./config": {
      "types": "./src/tamagui.config.ts",
      "default": "./src/tamagui.config.ts"
    },
    "./tokens": {
