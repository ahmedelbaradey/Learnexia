  },
  "peerDependencies": {
    "react": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    }
  },
  "devDependencies": {
    "@learnexia/eslint-config": "workspace:*",
    "@learnexia/tsconfig": "workspace:*",
    "@types/react": "^18.3.12",
    "eslint": "^9.17.0",
    "react": "^18.3.1",
    "typescript": "^5.7.2"
  }
