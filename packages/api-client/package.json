{
  "name": "@learnexia/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    },
    "./query": {
      "types": "./src/query/index.ts",
      "default": "./src/query/index.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "default": "./src/schemas.ts"
    },
    "./generated": {
      "types": "./src/generated/index.ts",
      "default": "./src/generated/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "gen:api": "node -e \"require('child_process').spawnSync(process.execPath,[require.resolve('nswag/bin/nswag.js'),'run','nswag.json'],{stdio:'inherit'})\"",
    "refresh:swagger": "node ./scripts/refresh-swagger.mjs"
  },
  "dependencies": {
    "@learnexia/shared": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "@tanstack/react-query": {
      "optional": false
    }
  },
  "devDependencies": {
    "@learnexia/eslint-config": "workspace:*",
    "@learnexia/tsconfig": "workspace:*",
    "@tanstack/react-query": "^5.64.0",
    "@types/react": "^18.3.12",
    "eslint": "^9.17.0",
    "nswag": "^14.7.1",
    "react": "^18.3.1",
    "typescript": "^5.7.2"
  }
}
