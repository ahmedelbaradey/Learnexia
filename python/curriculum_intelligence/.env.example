# curriculum-intelligence — environment template. COPY to .env and fill in.
# NEVER commit real secrets. In compose, these are injected via ${VAR} references.

# --- Database (the SAME Postgres the .NET backend uses; curriculum schema) ---
# Inside docker-compose use the service name `postgres`:
DATABASE_URL=postgresql://postgres:admin@postgres:5432/Learnexia
CURRICULUM_SCHEMA=curriculum

# --- MinIO / S3 (same creds as the .NET MinIOConfiguration; curriculum bucket) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
CURRICULUM_BUCKET=curriculum

# --- Parser backend selection ---
# mock (DEFAULT — dev + CI; no external services) | azure_di (live — needs the keys below)
PARSER_BACKEND=mock

# --- Azure Document Intelligence (DEVOPS-GATED — leave empty until provisioned) ---
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
AZURE_DI_MODEL_ID=prebuilt-layout
AZURE_DI_LOCALE=ar

# --- Anthropic / Claude (hierarchy extraction + diagram captioning — DEVOPS-GATED) ---
# Mock-now: leave EXTRACTOR_BACKEND=mock (default) and the key empty in dev + CI.
# To go live: set EXTRACTOR_BACKEND=claude AND ANTHROPIC_API_KEY. If the backend
# is 'claude' but the key is missing the worker degrades to the mock with a warning.
ANTHROPIC_API_KEY=
EXTRACTOR_BACKEND=mock
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Parse poller tuning ---
POLL_INTERVAL_SECONDS=5
POLL_JOB_TYPE=parse
POLL_BATCH_SIZE=1

# --- Ingest poller tuning (BL-05 — second lane, same process) ---
INGEST_POLL_INTERVAL_SECONDS=5
INGEST_POLL_JOB_TYPE=ingest
INGEST_POLL_BATCH_SIZE=1
# Worker EMITS confidences only; the .NET side applies the 0.7 cutoff. This value
# is advisory — used to annotate flags[], never to gate node/chunk emission.
INGEST_CONFIDENCE_THRESHOLD=0.7
INGEST_MAX_CHUNK_CHARS=1200

# --- Infer-edges poller tuning (BL-03 — third lane, same process) ---
INFER_POLL_INTERVAL_SECONDS=5
INFER_POLL_JOB_TYPE=infer_edges
INFER_POLL_BATCH_SIZE=1
# Edge inferer backend: mock (DEFAULT — dev + CI; deterministic, no network) |
# lightrag (live — needs ANTHROPIC_API_KEY). If 'lightrag' but the key is missing
# the worker degrades to the mock with a warning. The provenance string emitted in
# ResultJson.inference_model:
INFERER_BACKEND=mock
INFERENCE_MODEL=lightrag-mock-v1
INFER_ANTHROPIC_MODEL=claude-sonnet-4-6
# Advisory confidence floor the worker MAY apply (default 0 = keep all). The .NET
# EdgeInferenceAdvanceService owns the real clamp/cutoff — this never gates structurally.
INFER_MIN_CONFIDENCE=0

# --- Health server / logging ---
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8091
LOG_LEVEL=INFO
