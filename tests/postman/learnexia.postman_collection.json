{
	"info": {
		"name": "Learnexia API Smoke Suite",
		"description": "Committed smoke collection run by Newman in CI against the deployed Contabo host. Base URL is injected via the `baseUrl` collection/environment variable (e.g. http://your.contabo.host:8080) so nothing is hardcoded. No Postman cloud API call -> no test credits consumed.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		}
	],
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "Liveness - GET /health/live",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Response status code is 200\", function () {",
									"    pm.expect(pm.response.code).to.equal(200);",
									"});",
									"",
									"pm.test(\"Body is non-empty\", function () {",
									"    pm.expect(pm.response.text()).to.not.be.empty;",
									"});",
									"",
									"pm.test(\"Response time is under 5s\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(5000);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health/live",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health",
								"live"
							]
						}
					},
					"response": []
				},
				{
					"name": "Readiness - GET /health",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Response status code is 200\", function () {",
									"    pm.expect(pm.response.code).to.equal(200);",
									"});",
									"",
									"pm.test(\"Accessible anonymously (not 401/403)\", function () {",
									"    pm.expect([401, 403]).to.not.include(pm.response.code);",
									"});",
									"",
									"pm.test(\"Body is non-empty\", function () {",
									"    pm.expect(pm.response.text()).to.not.be.empty;",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health"
							]
						}
					},
					"response": []
				}
			]
		}
	]
}
