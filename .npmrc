# Required for Expo / Metro module resolution in a pnpm monorepo.
node-linker=hoisted
# Don't auto-grab the *highest* version for unpinned peer ranges (e.g. tamagui's
# `react-dom: *`, expo-linear-gradient's expo peer) — that drags in react-dom 19
# / expo 56 past the SDK 52 pins. Resolve peers from what the workspace provides.
auto-install-peers=false
